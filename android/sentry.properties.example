# Sentry Configuration for Android
# Copy this file to sentry.properties and add your auth token

# Get your auth token from: https://sentry.io/settings/account/api/auth-tokens/
auth.token=YOUR_SENTRY_AUTH_TOKEN_HERE

# Organization and project from Sentry dashboard
defaults.org=servease-innovation
defaults.project=react-native

# Sentry URL (usually doesn't need to change)
defaults.url=https://sentry.io/
